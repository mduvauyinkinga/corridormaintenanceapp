rules_version = '2';
// ⚠️ REFERENCE SECURITY RULES — copy these into your Firebase console.
// These are provided for documentation; they are NOT applied automatically
// on a static GitHub Pages deployment.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request authed?
    function signedIn() {
      return request.auth != null;
    }

    // Helper: is the requesting user a resident?
    function isResident() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'resident';
    }

    // Helper: is the requesting user management?
    function isManagement() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'management';
    }

    // Helper: is the requested role one of the valid roles?
    // Only "resident" and "management" are allowed anywhere in the system.
    function isValidRole(role) {
      return role == 'resident' || role == 'management';
    }

    // Users: users can read/write their own doc; management can read/write all.
    // Residents may only manage their own doc and must keep role "resident".
    // Management may manage any user doc but must still use a valid role.
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isManagement());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'resident'
        && request.resource.data.roomId == null
        && request.resource.data.unitId == null;
      allow update: if isManagement()
        || (isResident()
            && request.auth.uid == uid
            && resource.data.roomId == null
            && request.resource.data.role == 'resident'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['roomId', 'unitId', 'roomLetter', 'block', 'roomNumber'])
            && getAfter(/databases/$(database)/documents/units/$(request.resource.data.unitId)).data.occupied == true
            && getAfter(/databases/$(database)/documents/units/$(request.resource.data.unitId)).data.residentId == request.auth.uid
            && getAfter(/databases/$(database)/documents/units/$(request.resource.data.unitId)).data.roomId == request.resource.data.roomId
            && getAfter(/databases/$(database)/documents/units/$(request.resource.data.unitId)).data.roomLetter == request.resource.data.roomLetter);
      // Management may remove a resident profile. The deployed Cloud Function
      // then releases the matching occupied unit automatically.
      allow delete: if isManagement();
    }

    // Rooms: readable by all signed-in users; written only by management.
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if isManagement();
    }

    // Units: readable by all signed-in users; written by management (or a
    // resident claiming their OWN unit that is CURRENTLY unoccupied).
    //
    // A resident may claim a unit only if:
    //   - the unit was previously unoccupied (resource.data.occupied == false),
    //   - they are also the assigned resident (residentId == their uid),
    //   - the unit is being marked occupied (== true).
    // This prevents a resident from taking over an already-occupied unit.
    match /units/{unitId} {
      allow read: if signedIn();
      allow create: if isManagement();
      allow update: if isManagement()
        || (isResident()
            && resource.data.occupied == false
            && (resource.data.bedNumber == 1 || resource.data.bedNumber == 2)
            && request.resource.data.occupied == true
            && request.resource.data.residentId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['occupied', 'residentId'])
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.roomId == resource.data.roomId
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.unitId == unitId
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.roomLetter == resource.data.roomLetter);
    }

    // Messages for a whole room (for example, everyone in F506).
    match /unitAnnouncements/{announcementId} {
      allow read: if isManagement()
        || (isResident()
            && resource.data.roomId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roomId);
      allow create: if isManagement()
        && request.resource.data.roomId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500;
      allow update, delete: if false;
    }

    // Complaints: residents can create and read their own; management can
    // read all and update status.
    match /complaints/{complaintId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.residentId || isManagement());
      allow create: if isResident()
        && request.resource.data.residentId == request.auth.uid;
      allow update: if isManagement()
        || (
          // Residents may edit their own complaint while the status stays
          // the same (e.g. changing category/issues/notes on a draft).
          isResident()
          && request.auth.uid == resource.data.residentId
          && request.resource.data.status == resource.data.status
        )
        || (
          // Residents may CANCEL their own complaint ONLY from the
          // "Submitted" or "Received" states, setting status to
          // "Cancelled". All other fields must remain untouched — only
          // `status` and `updatedAt` may change. This prevents a resident
          // from altering residentId, roomId, unitId, priority, category,
          // issues, etc., or jumping from a further-along workflow state.
          isResident()
          && request.auth.uid == resource.data.residentId
          && (resource.data.status == 'Submitted' || resource.data.status == 'Received')
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'updatedAt'])
        );
      allow delete: if false;

      // Maintenance notes subcollection.
      // Management can create, read and update notes. Residents can READ
      // notes on their own complaint but can never create/edit/delete them.
      match /maintenanceNotes/{noteId} {
        allow read: if signedIn()
          && (isManagement()
              || (request.auth.uid
                  && get(/databases/$(database)/documents/complaints/$(complaintId)).data.residentId == request.auth.uid));
        allow create: if isManagement();
        allow update: if isManagement();
        allow delete: if false;
      }

      // Timeline subcollection (Phase 2.2).
      // Records every complaint lifecycle event. Management can write
      // events; the resident who owns the complaint (or management) can read.
      match /timeline/{eventId} {
        allow read: if signedIn()
          && (isManagement()
              || (request.auth.uid
                  && get(/databases/$(database)/documents/complaints/$(complaintId)).data.residentId == request.auth.uid));
        allow create: if signedIn()
          && (isManagement()
              || (request.auth.uid
                  && get(/databases/$(database)/documents/complaints/$(complaintId)).data.residentId == request.auth.uid));
        allow update: if isManagement();
        allow delete: if false;
      }
    }
  }
}
