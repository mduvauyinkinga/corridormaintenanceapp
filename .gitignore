# Corridor Maintenance App — deploy hygiene
# NOTE: legacy Firebase/seed tools now live under archive/ — never deployed.
# resident-facing site files ship to GitHub Pages.
# Keep archive/ in the repo for reference.
# NOTE: package-lock.json must be TRACKED (not gitignored).
.firebase/
.firestore-indexes-local.json
firestore-debug.log
ui-debug.log
firebase-debug.log

# Node / functions artefacts (functions/ deps are installed at deploy time)
node_modules/
functions/node_modules/
archive/firebase-legacy/functions/node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Local env / keys — never commit real secrets here
.env
.env.*
*.key.json
serviceAccount*.json

# Log files — not needed in repo
server-out.log
server-err.log
frontend-err.log
frontend-out.log

# PGlite database — runtime database data, not source code
server/.pglite-data

# Personal documents — not part of the web app source
Full Presentation.pdf
"Corridor Hill Residence Maintainance Website.docx"

# NOTE: package-lock.json must be TRACKED. Renders npm ci build requires a committed lockfile.

