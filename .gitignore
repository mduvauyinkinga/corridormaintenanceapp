# Corridor Maintenance App — deploy hygiene
# NOTE: legacy Firebase/seed utilities now live under archive/ and are
# never published — the GitHub Actions workflow only ships the
# resident-facing site files to Pages. Keep archive/ in the repo for
# reference; do NOT delete it until the mobile app has fully migrated
# off Firestore (see README).

# Local Firebase CLI / emulator artefacts
.firebase/
.firestore-indexes-local.json
firestore-debug.log
ui-debug.log
firebase-debug.log

# Node / functions artefacts (functions/ deps are installed at deploy time)
node_modules/
functions/node_modules/
archive/firebase-legacy/functions/node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Local env / keys — never commit real secrets here
.env
.env.*
*.key.json
serviceAccount*.json
